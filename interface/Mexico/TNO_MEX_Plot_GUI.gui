guiTypes = {
	containerWindowType = {
		name = "TNO_Plot_Tracker"
		orientation = center
		origo = center
		moveable = yes
		fade_time = 300
		fade_type = linear
		show_sound = menu_open_window
		size = { width = 533 height = 623 }
		background = {
			name = "TNO_Plot_Tracker_bg"
			quadTextureSprite = "GFX_tiled_bg"
		}

		containerWindowType = {
			name = "TNO_plots_container"
			#orientation = center_down
			position = { x = 0 y = 91 }
			size = { width = -10 height = -9 }
			verticalScrollbar = "right_vertical_slider"
			smooth_scrolling = yes
			background = {
				name = "TNO_plots_container_bg"
				quadTextureSprite = "GFX_tiled_window_transparent"
				alwaystransparent = yes
			}

			gridboxtype = {
				name = "TNO_plots_gridbox"
				position = { x = 12 y = 5 }
				slotsize = { width = 1 height = 1 }
				add_horizontal = no
			}
		}

		containerWindowType = {
			name = "TNO_Plot_Tracker_title_container"
			position = { x = 0 y = 19 }
			size = { width = 509 height = 71 }
			orientation = center_up
			origo = center_up
			background = {
				name = "TNO_Plot_Tracker_title_container_bg"
				quadTextureSprite = "GFX_crt_1b_tile"
				alwaystransparent = yes
			}

			instantTextBoxType = {
				name = "TNO_Plot_Tracker_title"
				font = "aldrich_36_outline"
				text = "Plot Tracker"
				maxWidth = 509
				maxHeight = 52
				vertical_alignment = center
				format = center
				fixedsize = yes
				alwaystransparent = yes
			}

			buttonType = {
				name = "TNO_Plot_Tracker_close"
				orientation = upper_right
				spriteType = "GFX_crt_closebutton_large"
				position = { x = -41 y = 8 }
				clicksound = click_close
				pdx_tooltip = "CLOSE"
				shortcut = "ESCAPE"
			}
		}
	}

	containerWindowType = {
		name = "TNO_plot_entry"
		size = { width = 488 height = 170 }

		containerWindowType = {
			name = "TNO_plot_points_container"
			orientation = center_down
			origo = center_down
			position = { x = 0 y = -3 }
			size = { width = 100%% height = -3 }
			horizontalScrollbar = "bottom_horizontal_slider"
			smooth_scrolling = yes
			background = {
				name = "TNO_plots_container_bg"
				quadTextureSprite = "GFX_tiled_window_transparent"
				alwaystransparent = yes
			}
		
			gridboxtype = {
				name = "TNO_plot_points_gridbox"
				position = { x = 0 y = 146 }
				slotsize = { width = 1 height = 1 }
				add_horizontal = yes
			}
		}

		# to fix my ocd about the drawing order
		containerWindowType = {
			name = "TNO_plot_entry_background_container"
			size = { width = 100%% height = -10 }
			background = {
				name = "TNO_plot_entry_bg"
				quadTextureSprite = "GFX_crt_1b_tile"
				alwaystransparent = yes
			}
		}

		containerWindowType = {
			name = "TNO_plot_title_container"
			size = { width = 100%% height = 70 }
			background = {
				name = "TNO_plot_title_container_bg"
				quadTextureSprite = "GFX_crt_1b_tile"
				alwaystransparent = yes
			}

			instantTextBoxType = {
				name = "TNO_plot_title"
				font = "Bomb_18"
				text = "TNO_plot_title_text"
				maxWidth = 488
				maxHeight = 70
				vertical_alignment = center
				format = center
				pdx_tooltip = "TNO_plot_title_tt"
				pdx_tooltip_delayed = "TNO_plot_title_tt_delayed"
			}
		}
	}

	containerWindowType = {
		name = "TNO_plot_point_entry"
		size = { width = 200 height = 70 }
